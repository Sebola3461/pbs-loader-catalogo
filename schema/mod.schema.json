{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sebola3461.github.io/pbs-loader-catalogo/schema/mod.schema.json",
  "title": "Mod do catálogo da comunidade",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nome", "tipo", "autor", "dono", "descricao", "versoesDoJogo", "origem"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "#/$defs/id" },
    "nome": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "tipo": { "enum": ["plugin", "onibus", "mapa", "skin", "destino", "som", "outro"] },
    "autor": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "dono": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["github"],
          "properties": { "github": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["site"],
          "properties": {
            "site": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
          }
        }
      ]
    },
    "descricao": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]+$" },
    "versoesDoJogo": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{1,6}$" }
    },
    "dependencias": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "origem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["github"],
          "properties": {
            "github": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repo", "tag", "arquivo"],
              "properties": {
                "repo": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$" },
                "tag": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,60}$" },
                "arquivo": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,95}\\.(dll|zip)$" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["externa"],
          "properties": {
            "externa": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url"],
              "properties": { "url": { "$ref": "#/$defs/https" } }
            }
          }
        }
      ]
    },
    "pagina": { "$ref": "#/$defs/https" },
    "oculto": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$" },
    "https": { "type": "string", "maxLength": 500, "pattern": "^https://[^\\s/?#.]+(\\.[^\\s/?#.]+)+([/?#]\\S*)?$" }
  }
}
